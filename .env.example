# Minimum for live-testing Birdy AI, scheduled Slack messages and client health.
MONGODB_URI=mongodb+srv://USER:PASSWORD@birdyaidev.8qxw5q.mongodb.net/
MONGODB_DB=birdyaidev
JWT_SECRET=
AI_CREDENTIAL_ENCRYPTION_KEY=      # must be the SAME key production/dev uses, or stored Slack tokens can't be decrypted
CRON_SECRET=
OPENAI_API_KEY=                    # Birdy chat + suggestion copy
OPENAI_MODEL=gpt-4o
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Creatives (placeholders)
FRONTEND_URL=https://birdy-beta.vercel.app   # Slack "Scale" and other deep links into the app
CREATIVE_UPLOAD_SECRET=            # signs upload grants; the frontend must use the same value
BLOB_READ_WRITE_TOKEN=             # Vercel Blob token, for deleting archived tests' media

# Alert emails over SMTP (same settings as nodemailer). Leave empty to skip emails.
# Gmail demo: create an app password at https://myaccount.google.com/apppasswords (needs 2-Step Verification),
# then SMTP_USER = that Gmail address and SMTP_PASS = the 16-character app password (no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true                   # true = SSL on 465; false = STARTTLS on 587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=                        # optional, e.g. "Birdy <alerts@yourdomain.com>"; defaults to Birdy <SMTP_USER>. Gmail only sends as SMTP_USER or a verified alias
