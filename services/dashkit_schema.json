{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashkit.dev/schema/dashboard-v3.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 3
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "widgets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "version": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "layout": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 11
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 999
              },
              "w": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "h": {
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              }
            },
            "required": [
              "x",
              "y",
              "w",
              "h"
            ],
            "additionalProperties": false
          },
          "data": {},
          "bindings": {
            "type": "object",
            "properties": {
              "query": {
                "type": "object",
                "properties": {
                  "metrics": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "metric": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "metric"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 20
                  },
                  "by": {
                    "type": "string"
                  },
                  "over": {
                    "type": "string",
                    "enum": [
                      "day",
                      "week",
                      "month"
                    ]
                  },
                  "window": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "preset": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "preset"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "from": {
                            "type": "string"
                          },
                          "to": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "from",
                          "to"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "filters": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "compare": {
                    "type": "string",
                    "const": "previous"
                  },
                  "sort": {
                    "type": "object",
                    "properties": {
                      "metric": {
                        "type": "string"
                      },
                      "dir": {
                        "type": "string",
                        "enum": [
                          "asc",
                          "desc"
                        ]
                      }
                    },
                    "required": [
                      "metric",
                      "dir"
                    ],
                    "additionalProperties": false
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "spark": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "metrics",
                  "window"
                ],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "hidden": {
            "type": "boolean"
          },
          "locked": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "type",
          "version",
          "layout"
        ],
        "additionalProperties": false
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "density": {
          "type": "string",
          "enum": [
            "comfortable",
            "compact"
          ]
        }
      },
      "required": [
        "density"
      ],
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "lastAuthor": {
          "type": "string",
          "enum": [
            "user",
            "ai",
            "code"
          ]
        }
      },
      "required": [
        "createdAt",
        "updatedAt",
        "lastAuthor"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "version",
    "title",
    "widgets",
    "meta"
  ],
  "additionalProperties": false,
  "title": "Dashboard"
}
